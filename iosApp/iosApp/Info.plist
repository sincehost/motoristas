<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>

	<!-- GENERATE_INFOPLIST_FILE=YES gera essas chaves em tempo de build a
	     partir das build settings, então normalmente não precisam estar
	     aqui — mas ferramentas externas (Codemagic code_signing_manager.rb)
	     leem esse arquivo bruto direto do disco, sem passar pelo Xcode, e
	     quebram (NoMethodError) quando CFBundleIdentifier não existe aqui. -->
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>

	<!-- Nome exibido na tela inicial, TestFlight e App Store — PRODUCT_NAME
	     (Config.xcconfig) ficou como "Motorista" por motivo histórico do
	     projeto, mas o nome público do app é "Trakvia". -->
	<key>CFBundleDisplayName</key>
	<string>Trakvia</string>

	<key>CFBundleDevelopmentRegion</key>
	<string>pt-BR</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>pt-BR</string>
	</array>

	<key>NSCameraUsageDescription</key>
<string>Precisamos da câmera para fotografar o painel do veículo</string>
<key>NSPhotoLibraryUsageDescription</key>
<string>Precisamos acessar suas fotos para selecionar imagens</string>
<key>NSFaceIDUsageDescription</key>
<string>Usamos Face ID para proteger o acesso ao app com sua sessão já conectada</string>
</dict>
</plist>
