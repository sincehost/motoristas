platform :ios, '14.0'


# Dinâmico (padrão) — linkage estático quebra o recurso "Heartbeat" interno
# do Firebase (FIRHeartbeatController não pega no link final do app), então
# voltamos pro dinâmico; a versão travada abaixo já resolve o problema
# original (símbolos do GoogleUtilities sumindo por incompatibilidade de
# versão entre FirebaseCore/GoogleUtilities baixados na hora do build).
use_frameworks!

target 'iosApp' do
  # Pods do projeto
  # Versão travada de propósito: sem isso, cada build do Codemagic baixa o
  # Firebase mais novo publicado na hora, e uma versão nova incompatível entre
  # FirebaseCore/GoogleUtilities quebra o link sem nenhuma mudança nossa.
  pod 'FirebaseMessaging', '11.15.0'
  # Declarados explícitos (mesma versão) — senão ficam como dependência
  # transitiva implícita e o linker do app derruba classes deles (ex:
  # FIRHeartbeatController, do FirebaseCoreInternal) por não achar que
  # precisa incluir esse código no binário final.
  pod 'FirebaseCore', '11.15.0'
  pod 'FirebaseCoreInternal', '11.15.0'
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '14.0'
      config.build_settings['OTHER_LDFLAGS'] ||= ['$(inherited)']
      config.build_settings['OTHER_LDFLAGS'] << '-lsqlite3'
      config.build_settings['OTHER_LDFLAGS'] << '-ObjC'

      # Xcode 26 não gera mais o link automático entre pods aqui (bug/mudança
      # recente reportada em vários projetos CocoaPods+Firebase) — o
      # FirebaseCore não acha o GoogleUtilities/FirebaseCoreInternal na hora
      # de linkar a própria framework dele. Força explícito.
      if target.name == 'FirebaseCore'
        config.build_settings['OTHER_LDFLAGS'] << '-framework "GoogleUtilities"'
        config.build_settings['OTHER_LDFLAGS'] << '-framework "FirebaseCoreInternal"'
      end
    end
  end
end