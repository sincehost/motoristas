<?xml version="1.0" encoding="utf-8"?>
<!--
    CORREÇÃO M5: Restringir tráfego HTTP sem criptografia.
    Antes, usesCleartextTraffic=true permitia HTTP para QUALQUER domínio.

    A exceção de cleartext pra "10.0.0.0"/"192.168.0.0"/"localhost" foi
    removida: confirmado que nenhum tenant roda API local sem HTTPS, e
    aqueles valores nunca cobriam de verdade uma faixa de IP local mesmo
    (o <domain> do Android não aceita CIDR/faixa, só IP/host exato — então
    na prática já não protegia nada). Se um dia isso for necessário de
    verdade, adicionar aqui o IP/domínio exato do servidor em questão.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
